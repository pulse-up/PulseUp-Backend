# Select the `local` environment. This request stores the returned JWT in adminToken.

### 1. Login as admin and capture the JWT
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@cput.ac.za",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.token); %}

### 2. Protected request without a token (expected: 401)
GET {{baseUrl}}/api/admins
Accept: application/json

### 3. Protected request with the token from step 1
GET {{baseUrl}}/api/admins
Accept: application/json
Authorization: Bearer {{adminToken}}

### 4. View all appointments as admin
GET {{baseUrl}}/api/appointments
Accept: application/json
Authorization: Bearer {{adminToken}}

### 5. View all time slots as admin
GET {{baseUrl}}/api/time-slots
Accept: application/json
Authorization: Bearer {{adminToken}}
