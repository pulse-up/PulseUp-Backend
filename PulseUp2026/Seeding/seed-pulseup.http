# Select the `local` environment before running this file.


### 1. Bootstrap the first administrator (run only when the admins table is empty)
POST {{baseUrl}}/api/auth/bootstrap-admin
Content-Type: application/json
Accept: application/json

{
  "email": "admin@cput.ac.za",
  "password": "{{adminPassword}}",
  "firstName": "PulseUp",
  "lastName": "Administrator",
  "phoneNumber": "+27 21 440 1000",
  "adminNumber": "ADM-2026-001",
  "department": "Campus Health Services"
}

> {% client.global.set("adminToken", response.body.token); %}

### 2. Sign in as the existing administrator (use this instead of step 1 after bootstrap)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@cput.ac.za",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.token); %}

### 3. Register General Consultations staff
POST {{baseUrl}}/api/auth/register/staff
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "amanda.naidoo@cput.ac.za",
  "password": "{{staffPassword}}",
  "firstName": "Amanda",
  "lastName": "Naidoo",
  "phoneNumber": "+27 21 440 1101",
  "staffNumber": "STF-2026-001",
  "department": "General Consultations",
  "position": "General Practitioner",
  "specialization": "Primary health care"
}

> {% client.global.set("generalConsultationsStaffId", response.body.userId); %}

